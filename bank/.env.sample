# Unity Banking backend environment variables
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Initial account created automatically only when it does not already exist.
DEFAULT_USER_USERNAME=2025
DEFAULT_USER_PASSWORD=change-this-in-production
DEFAULT_USER_PIN=2025
DEFAULT_USER_FULL_NAME=Unity Banking Customer
